# Frontend Environment Variables Template for Kerala Desam Next.js Portal

# Backend REST API URL (Production Render or Localhost)
# For local dev: http://localhost:5000/api
# For production Render: https://kerala-dhesam-admin.onrender.com/api
NEXT_PUBLIC_API_URL=https://kerala-dhesam-admin.onrender.com/api
API_URL=https://kerala-dhesam-admin.onrender.com/api

# Optional: Override build output directory
NEXT_DIST_DIR=.next

